# Banco de dados (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/gateway_glc?sslmode=require"

# Anthropic (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."

# Chave interna para endpoints do dashboard e simulação
INTERNAL_API_KEY="gerar-uma-chave-segura-aqui"

# API key do tenant demo (criado automaticamente na primeira simulação)
DEMO_API_KEY="demo-key-glc-2024"

# Exposta ao browser apenas para o dashboard interno
# Deve ser igual ao INTERNAL_API_KEY
NEXT_PUBLIC_INTERNAL_API_KEY="gerar-uma-chave-segura-aqui"
